# Secrets and connection settings for InfluxDB and Grafana.
#
# Copy this file to .env and replace every "change-me" value:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux)
# .env is listed in .gitignore, so the real values never go into git.

# InfluxDB (the database for all measurements)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=depot
INFLUXDB_BUCKET=depot
# A long random text. InfluxDB is set up with it, and the controller and Grafana use it to log in.
INFLUXDB_TOKEN=change-me-to-a-long-random-token
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me

# Grafana (the dashboard)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
